# Copy this file to .env and fill in real values.
# .env is read automatically (python-dotenv) -- never commit your real .env.

# --- OpenAI (used for script/storyboard/code generation and narration) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# Transient 429/5xx OpenAI errors are retried with exponential backoff + jitter.
OPENAI_RETRY_ATTEMPTS=6
OPENAI_RETRY_BASE_DELAY_SECONDS=2
OPENAI_RETRY_MAX_DELAY_SECONDS=45
# Keep an unavailable TTS request from blocking an entire Manim render.
OPENAI_TTS_TIMEOUT_SECONDS=60
OPENAI_TTS_RETRY_ATTEMPTS=3

# --- Which voice engine actually renders the narration audio ---
# "openai"  -> use OpenAI TTS above (pre-generated into a shared cache before Manim)
# "offline" -> silent placeholder audio, zero API calls -- good for a
#              free dry-run of storyboard/codegen/render/concat mechanics
VOICE_PROVIDER=openai

# --- Pipeline tuning ---
RENDER_QUALITY=qm            # ql (fast draft) | qm (balanced) | qh (1080p60) | qk (4k)
MAX_SCENES=6                 # cap on number of beats/scenes per video
MAX_CODEGEN_RETRIES=3        # self-repair attempts if generated Manim code fails to render
TARGET_SECONDS_PER_BEAT=25
# Maximum wall-clock time for one final Manim scene render. High-quality
# 1080p/60fps renders can take a long time on a CPU-only computer.
RENDER_TIMEOUT_SECONDS=3600
