# Copy this file to .env and fill in real values.
# .env is read automatically (python-dotenv) -- never commit your real .env.

# --- Gemini (used for script/storyboard/code generation always, and as the
#     TEST voice engine while VOICE_PROVIDER=gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Transient 429/5xx Gemini errors are retried with exponential backoff + jitter.
GEMINI_RETRY_ATTEMPTS=6
GEMINI_RETRY_BASE_DELAY_SECONDS=2
GEMINI_RETRY_MAX_DELAY_SECONDS=45

# --- Which voice engine actually renders the narration audio ---
# "gemini"    -> use Gemini TTS above (good for testing, no extra setup)
# "omnivoice" -> switch to OmniVoice once you're ready (fill in section below)
# "offline"   -> silent placeholder audio, zero API calls -- good for a
#                free dry-run of storyboard/codegen/render/concat mechanics
VOICE_PROVIDER=gemini

# --- OmniVoice (only needed once VOICE_PROVIDER=omnivoice) ---
# backend "openai_compatible" = a self-hosted OmniVoice server, e.g. the
#         `omnivoice-server` PyPI package, exposing POST /v1/audio/speech
# backend "wavespeed"         = the hosted WaveSpeed OmniVoice REST API
OMNIVOICE_BACKEND=openai_compatible
OMNIVOICE_BASE_URL=http://127.0.0.1:8880
OMNIVOICE_API_KEY=
OMNIVOICE_VOICE=alloy
OMNIVOICE_VOICE_DESCRIPTION=male, calm, moderate pitch

# --- Pipeline tuning ---
RENDER_QUALITY=qh            # ql (fast draft) | qm | qh (1080p60) | qk (4k)
MAX_SCENES=6                 # cap on number of beats/scenes per video
MAX_CODEGEN_RETRIES=3        # self-repair attempts if generated Manim code fails to render
TARGET_SECONDS_PER_BEAT=25
